<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_MachineMode" Id="{7a1c0001-0000-4000-9000-000000000001}">
    <Declaration><![CDATA[TYPE E_MachineMode :
(
	// Maszyna zatrzymana - zadna sekwencja nie pracuje
	MODE_STOP		:= 0,

	// Praca automatyczna
	MODE_AUTO		:= 1,

	// Praca reczna - sterowanie pojedynczymi elementami,
	// dozwolony ruch w obu kierunkach
	MODE_MANUAL		:= 2,

	// Praca krokowa - sekwencja czeka na potwierdzenie
	// operatora przed kazdym krokiem
	MODE_STEP		:= 3,

	// Bazowanie / odstawianie do pozycji startowej
	MODE_HOME		:= 4
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
