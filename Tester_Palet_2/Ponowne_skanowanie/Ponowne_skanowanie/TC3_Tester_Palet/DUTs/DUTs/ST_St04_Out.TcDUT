<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_St04_Out" Id="{7a1c0032-0000-4000-9000-000000000032}">
    <Declaration><![CDATA[TYPE ST_St04_Out :
STRUCT
	// =========================================================
	// STACJA 4 - CEWKI ZAWOROW
	// =========================================================
	//
	// Mapowanie w MAIN wg opisu wyjsc:
	//   xLowerExtend        -> GVL.OUTPUTS[4]   dolne wysun
	//   xLowerRetract       -> GVL.OUTPUTS[3]   dolne cofnij
	//   xUpperWideExtend    -> GVL.OUTPUTS[7]   gorne zewnetrzne
	//                                           i srodkowa wysun
	//   xUpperWideRetract   -> GVL.OUTPUTS[2]   te same cofnij
	//   xUpperNarrowExtend  -> GVL.OUTPUTS[5]   gorne srodkowe wysun
	//   xUpperNarrowRetract -> GVL.OUTPUTS[6]   gorne srodkowe cofnij
	//
	// [?] Opis wyjsc 2/7 i 5/6 nazywa obie grupy "srodkowymi".
	// Przyjete: 7/2 to trzy silowniki od szerokich desek,
	// 5/6 to dwa od waskich. Do potwierdzenia na maszynie -
	// zamiana dotyczy wylacznie mapowania w MAIN, nie kodu stacji.

	xLowerExtend		: BOOL;
	xLowerRetract		: BOOL;

	xUpperWideExtend	: BOOL;
	xUpperWideRetract	: BOOL;

	xUpperNarrowExtend	: BOOL;
	xUpperNarrowRetract	: BOOL;

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
