<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_StackAlarm" Id="{7a1c0040-0000-4000-9000-000000000040}">
    <Declaration><![CDATA[TYPE E_StackAlarm :
(
	ALM_STK_NONE			:= 0,

	// Wozek nie dojechal do pozycji w zadanym czasie
	ALM_STK_MOVE_TIMEOUT	:= 1,

	// Szczeki nie potwierdzily ruchu
	ALM_STK_JAW_TIMEOUT		:= 2,

	// Pozycje wpisane przez operatora nie tworza rosnacego
	// ani malejacego ciagu - dol / srodek / gora musza lezec
	// po kolei, inaczej wozek pojechalby w zla strone
	ALM_STK_POS_INVALID		:= 3,

	// Blad falownika wozka
	ALM_STK_DRIVE_FAULT		:= 4,

	// Brak wywolania M_Config
	ALM_STK_NOT_CONFIGURED	:= 5,

	// Wozek zjechal z potwierdzonej pozycji bez komendy
	ALM_STK_POSITION_LOST	:= 6
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
