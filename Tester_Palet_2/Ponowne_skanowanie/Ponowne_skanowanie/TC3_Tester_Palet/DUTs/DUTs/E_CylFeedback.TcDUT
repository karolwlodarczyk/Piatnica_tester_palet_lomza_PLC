<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_CylFeedback" Id="{7a1c0011-0000-4000-9000-000000000011}">
    <Declaration><![CDATA[TYPE E_CylFeedback :
(
	// Brak sprzezenia - ruch wylacznie na czasowkach
	CYLFB_NONE		:= 0,

	// Krancowki na jednym albo obu koncach
	CYLFB_SWITCHES	:= 1,

	// Przetwornik polozenia IO-Link, wartosc bezwzgledna DINT.
	// Polozenia koncowe to progi nastawiane przez operatora,
	// a nie zdarzenia dwustanowe.
	CYLFB_ANALOG	:= 2,

	// Sprzezenie podawane z zewnatrz przez stacje.
	// Uzywane tam, gdzie jeden zawor steruje GRUPA silownikow,
	// a pomiar jest indywidualny - stacja 4. Stacja agreguje
	// wskazania FB_CylPosMonitor i podaje wynik na wejscia
	// xFbExtIn / xFbRetIn.
	CYLFB_EXTERNAL	:= 3
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
