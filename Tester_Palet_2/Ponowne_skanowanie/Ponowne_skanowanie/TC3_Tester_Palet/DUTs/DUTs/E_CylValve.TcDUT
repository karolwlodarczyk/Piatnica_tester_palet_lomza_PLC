<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_CylValve" Id="{7a1c0010-0000-4000-9000-000000000010}">
    <Declaration><![CDATA[TYPE E_CylValve :
(
	// Zawor monostabilny, jedna cewka.
	// TRUE = wysuniety, FALSE = wycofany sprezyna.
	// Przyklad: szczeki stacji 5, FestoValves_1[1..3, 1]
	CYLV_SINGLE			:= 0,

	// Zawor bistabilny, dwie cewki wykluczajace sie
	CYLV_DOUBLE			:= 1,

	// Zawor 3-polozeniowy. Wysuw i cofniecie po wlasnej cewce,
	// oba wyjscia zdjete = polozenie spoczynkowe (srodkowe).
	CYLV_3POS_MID		:= 2,

	// Zawor 3-polozeniowy, w ktorym cofniecie realizuje
	// zdjecie OBU cewek
	CYLV_3POS_OFF_RET	:= 3
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
