 Szczeki maja wlasne rekordy w aCyl:
   25  szczeki desztaplarki (stacja 3)
   26  szczeki sztaplarki   (stacja 11)]]></Comment><BitSize>896</BitSize><Properties><Property><Name>TcPersistent</Name></Property></Properties></SubItem><SubItem><Name Static="true">St11</Name><Type>ST_StackPersist</Type><BitSize>896</BitSize><Properties><Property><Name>TcPersistent</Name></Property></Properties></SubItem></DataType><DataType><Name>GVL</Name><SubItem><Name Static="true">IO_Destaker_Act_Pos</Name><Type>DINT</Type><BitSize>32</BitSize><Properties><Property><Name>TcDataArea</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name Static="true">IO_Staker_Act_Pos</Name><Type>DINT</Type><BitSize>32</BitSize><Properties><Property><Name>TcDataArea</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name Static="true">NORD_DRIVE_IN</Name><Type>ST_NordSK550P_In</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>960</BitSize><Properties><Property><Name>TcDataArea</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name Static="true">NORD_DRIVE_OUT</Name><Type>ST_NordSK550P_Out</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>960</BitSize><Properties><Property><Name>TcDataArea</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name Static="true">FestoValves_1</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>8</Elements></ArrayInfo><ArrayInfo><LBound>1</LBound><Elements>2</Elements></ArrayInfo><BitSize>128</BitSize><Properties><Property><Name>TcDataArea</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name Static="true">FestoValves_2</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>8</Elements></ArrayInfo><ArrayInfo><LBound>1</LBound><Elements>2</Elements></ArrayInfo><BitSize>128</BitSize><Properties><Property><Name>TcDataArea</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name Static="true">INPUTS</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>