ment><![CDATA[ Open and if not existing create ]]></Comment><BitSize>32</BitSize><Default><Value>100</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_OPENREAD</Name><Type>UDINT</Type><Comment><![CDATA[ Open existing for read access ]]></Comment><BitSize>32</BitSize><Default><Value>101</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_OPENWRITE</Name><Type>UDINT</Type><Comment><![CDATA[ Open existing for write access ]]></Comment><BitSize>32</BitSize><Default><Value>102</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_CREATEFILE</Name><Type>UDINT</Type><Comment><![CDATA[ Create ]]></Comment><BitSize>32</BitSize><Default><Value>110</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_CLOSEHANDLE</Name><Type>UDINT</Type><Comment><![CDATA[ Close ]]></Comment><BitSize>32</BitSize><Default><Value>111</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FOPEN</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>120</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FCLOSE</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>121</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FREAD</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>122</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FWRITE</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>123</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FSEEK</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>124</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FTELL</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>125</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FGETS</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>126</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FPUTS</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>127</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FSCANF</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>128</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FPRINTF</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>129</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FEOF</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>130</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FDELETE</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>131</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_FRENAME</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>132</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_MKDIR</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>138</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_RMDIR</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>139</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_REG_HKEYLOCALMACHINE</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>200</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_SENDEMAIL</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>300</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_TIMESERVICES</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>400</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_STARTPROCESS</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>500</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSERVICE_CHANGENETID</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>600</Value></Default></SubItem><SubItem><Name Static="true">TIMESERVICE_DATEANDTIME</Name><Type>UDINT</Type><Comment><![CDATA[ Date/time ]]></Comment><BitSize>32</BitSize><Default><Value>1</Value></Default></SubItem><SubItem><Name Static="true">TIMESERVICE_SYSTEMTIMES</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>2</Value></Default></SubItem><SubItem><Name Static="true">TIMESERVICE_RTCTIMEDIFF</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>3</Value></Default></SubItem><SubItem><Name Static="true">TIMESERVICE_ADJUSTTIMETORTC</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">TIMESERVICE_TIMEZONINFORMATION</Name><Type>UDINT</Type><BitSize>32</BitSize><Default><Value>6</Value></Default></SubItem><SubItem><Name Static="true">ADSLOG_MSGTYPE_HINT</Name><Type>DWORD</Type><Comment><![CDATA[ Hint icon ]]></Comment><BitSize>32</BitSize><Default><Value>1</Value></Default></SubItem><SubItem><Name Static="true">ADSLOG_MSGTYPE_WARN</Name><Type>DWORD</Type><Comment><![CDATA[ Warning icon ]]></Comment><BitSize>32</BitSize><Default><Value>2</Value></Default></SubItem><SubItem><Name Static="true">ADSLOG_MSGTYPE_ERROR</Name><Type>DWORD</Type><Comment><![CDATA[ Error icon ]]></Comment><BitSize>32</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">ADSLOG_MSGTYPE_LOG</Name><Type>DWORD</Type><Comment><![CDATA[ Write message to log file ]]></Comment><BitSize>32</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">ADSLOG_MSGTYPE_MSGBOX</Name><Type>DWORD</Type><Comment><![CDATA[ View message in message box ]]></Comment><BitSize>32</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">ADSLOG_MSGTYPE_RESOURCE</Name><Type>DWORD</Type><BitSize>32</BitSize><Default><Value>64</Value></Default></SubItem><SubItem><Name Static="true">ADSLOG_MSGTYPE_STRING</Name><Type>DWORD</Type><BitSize>32</BitSize><Default><Value>128</Value></Default></SubItem><SubItem><Name Static="true">BOOTDATAFLAGS_RETAIN_LOADED</Name><Type>BYTE</Type><Comment><![CDATA[ Retain data loaded ]]></Comment><BitSize>8</BitSize><Default><Value>1</Value></Default></SubItem><SubItem><Name Static="true">BOOTDATAFLAGS_RETAIN_INVALID</Name><Type>BYTE</Type><Comment><![CDATA[ Retain data is invalid ]]></Comment><BitSize>8</BitSize><Default><Value>2</Value></Default></SubItem><SubItem><Name Static="true">BOOTDATAFLAGS_RETAIN_REQUESTED</Name><Type>BYTE</Type><BitSize>8</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">BOOTDATAFLAGS_PERSISTENT_LOADED</Name><Type>BYTE</Type><Comment><![CDATA[ Persistent data loaded ]]></Comment><BitSize>8</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">BOOTDATAFLAGS_PERSISTENT_INVALID</Name><Type>BYTE</Type><Comment><![CDATA[ Persistent data is invalid ]]></Comment><BitSize>8</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSTATEFLAGS_BSOD</Name><Type>BYTE</Type><Comment><![CDATA[ Blue screen of death ]]></Comment><BitSize>8</BitSize><Default><Value>1</Value></Default></SubItem><SubItem><Name Static="true">SYSTEMSTATEFLAGS_RTVIOLATION</Name><Type>BYTE</Type><Comment><![CDATA[ Realtime violation - latency time ]]></Comment><BitSize>8</BitSize><Default><Value>2</Value></Default></SubItem><SubItem><Name Static="true">nWatchdogTime</Name><Type>BYTE</Type><Comment><![CDATA[ Watchdog time. Depending of g_WatchdogConfig : seconds or minutes ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">FOPEN_MODEREAD</Name><Type>DWORD</Type><Comment><![CDATA["r": Opens for reading. If the file does not exist or cannot be found, the call fails.]]></Comment><BitSize>32</BitSize><Default><Value>1</Value></Default></SubItem><SubItem><Name Static="true">FOPEN_MODEWRITE</Name><Type>DWORD</Type><Comment><![CDATA["w": Opens an empty file for writing. If the given file exists, its contents are destroyed.]]></Comment><BitSize>32</BitSize><Default><Value>2</Value></Default></SubItem><SubItem><Name Static="true">FOPEN_MODEAPPEND</Name><Type>DWORD</Type><Comment><![CDATA["a": Opens for writing at the end of the file (appending) without removing the EOF marker before writing new data to the file; creates the file first if it doesnot exist.]]></Comment><BitSize>32</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">FOPEN_MODEPLUS</Name><Type>DWORD</Type><Comment><![CDATA["+": Opens for reading and writing]]></Comment><BitSize>32</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">FOPEN_MODEBINARY</Name><Type>DWORD</Type><Comment><![CDATA["b": Open in binary (untranslated) mode.]]></Comment><BitSize>32</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">FOPEN_MODETEXT</Name><Type>DWORD</Type><Comment><![CDATA["t": Open in text (translated) mode.]]></Comment><BitSize>32</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTFLAG_PRIOCLASS</Name><Type>WORD</Type><Comment><![CDATA[ Event class/priority	through textformatter]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTFLAG_FMTSELF</Name><Type>WORD</Type><Comment><![CDATA[ Format in message ]]></Comment><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTFLAG_LOG</Name><Type>WORD</Type><Comment><![CDATA[ Write to log file ]]></Comment><BitSize>16</BitSize><Default><Value>64</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTFLAG_MSGBOX</Name><Type>WORD</Type><Comment><![CDATA[ Display message box ]]></Comment><BitSize>16</BitSize><Default><Value>128</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTFLAG_SRCID</Name><Type>WORD</Type><Comment><![CDATA[ Src id instead of source name ]]></Comment><BitSize>16</BitSize><Default><Value>256</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTFLAG_AUTOFMTALL</Name><Type>WORD</Type><BitSize>16</BitSize><Default><Value>4096</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTSTATE_INVALID</Name><Type>WORD</Type><Comment><![CDATA[ Event object is not initialized ]]></Comment><BitSize>16</BitSize><Default><Value>0</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTSTATE_SIGNALED</Name><Type>WORD</Type><Comment><![CDATA[ Event object is in a signaled state ]]></Comment><BitSize>16</BitSize><Default><Value>1</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTSTATE_RESET</Name><Type>WORD</Type><Comment><![CDATA[ Event object is in a reset state ]]></Comment><BitSize>16</BitSize><Default><Value>2</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTSTATE_CONFIRMED</Name><Type>WORD</Type><Comment><![CDATA[ Event object is confirmed but not reset ]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">TCEVENTSTATE_RESETCON</Name><Type>WORD</Type><Comment><![CDATA[ Event object is confirmed and reset ]]></Comment><BitSize>16</BitSize><Default><Value>18</Value></Default></SubItem><SubItem><Name Static="true">TCEVENT_SRCNAMESIZE</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>15</Value></Default></SubItem><SubItem><Name Static="true">TCEVENT_FMTPRGSIZE</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>31</Value></Default></SubItem><SubItem><Name Static="true">eWatchdogConfig</Name><Type Namespace="Tc2_System">E_WATCHDOG_TIME_CONFIG</Type><BitSize>16</BitSize><Default><EnumText>E_WATCHDOG_TIME_CONFIG.eWATCHDOG_TIME_DISABLED</EnumText></Default></SubItem><SubItem><Name Static="true">DEFAULT_ADS_TIMEOUT</Name><Type>TIME</Type><Comment><![CDATA[ Default ADS timeout value ]]></Comment><BitSize>32</BitSize><Default><DateTime>5000</DateTime></Default></SubItem><SubItem><Name Static="true">PI</Name><Type>LREAL</Type><BitSize>64</BitSize><Default><Value>3.14159265358979</Value></Default></SubItem><SubItem><Name Static="true">MAX_STRING_LENGTH</Name><Type>UDINT</Type><Comment><![CDATA[ Max. length of T_MaxString (inclusive null delimiter) ]]></Comment><BitSize>32</BitSize><Default><Value>255</Value></Default></SubItem></DataType><DataType><Name>MAIN</Name><SubItem><Name Static="true">START_TEST</Name><Type>BOOL</Type><Comment><![CDATA[ =========================================================
 STEROWANIE
 =========================================================
 GLOWNY BIT TESTU TRASY. TRUE = jedziemy, FALSE = stop.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt01_StackReady</Name><Type>BOOL</Type><Comment><![CDATA[ =========================================================
 PROBA CALOSCIOWA: DOWOZ -> DESZTAPLOWANIE -> STACJA 4
 =========================================================

 Niezalezna od START_TEST. Wozi palety ze stacji 1 do
 desztaplarki, potem kazda zwolniona palete przez stacje 4
 z testem dociskow i ZATRZYMUJE ja na koncu stacji 4.
 Palete zabiera sie stamtad recznie.
 Potwierdzenie operatora: palety leza na stacji 1.
 Kod sam go zdejmuje po przyjeciu - kolejny stos wymaga
 podania go od nowa.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">START_FEED</Name><Type>BOOL</Type><Comment><![CDATA[ Start dowozu i obslugi transportu w tej probie]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xFeedNewStep</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nFeedPallets</Name><Type>UDINT</Type><Comment><![CDATA[ Ile palet przeszlo przez stacje 4]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">nFeedStep</Name><Type>INT</Type><Comment><![CDATA[ Podglad]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">sFeedPhase</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">nFeedStepOld</Name><Type>INT</Type><Comment><![CDATA[ Wewnetrzne sekwencji dowozu]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xFeedArmed</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xFeedAdvance</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nOutStep</Name><Type>INT</Type><Comment><![CDATA[ =========================================================
 TOR WYJSCIOWY - DRUGA PALETA W MASZYNIE
 =========================================================

 Transport jest rozbity na DWA niezalezne tory:

   nFeedStep  tor A: stacja 1 -> 3 -> 4 -> cykl stacji 5
   nOutStep   tor B: stacja 5 -> 6 -> ... -> 16

 Dzieki temu paleta po rozrywaniu jedzie w strone stacji 16
 SAMA, a desztaplarka moze w tym czasie wydac nastepna.
 W maszynie sa wtedy dwie palety naraz.

 Zasob wspolny to transporter stacji 5 (naped 5) i blokada.
 Dlatego tor A nie wjedzie na stacje 5, dopoki tor B z niej
 nie zjedzie - patrz krok 75.

 nOutStep = 0 znaczy TOR B WOLNY.]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">tFeedStep</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tonFeedStep</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">rtrgFeedStart</Name><Type Namespace="Tc2_Standard">R_TRIG</Type><BitSize>128</BitSize></SubItem><SubItem><Name Static="true">sOutPhase</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">nOutStepOld</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xOutNewStep</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOutArmed</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOutAdvance</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_Done</Name><Type>BOOL</Type><Comment><![CDATA[ Stacja 5 skonczyla cykl i oddala palete torowi B.
 Na tym sygnale desztaplarka wypuszcza nastepna palete.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt08_RollDown</Name><Type>BOOL</Type><Comment><![CDATA[ Zatrzask: rolki stacji 8 maja zostac w dole, dopoki lancuch
 nie zabierze palety. Bez niego kroki, ktore ich nie pisza,
 podnosilyby je z powrotem.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt08_AtStation</Name><Type>BOOL</Type><Comment><![CDATA[ Paleta jest na stacji 8 - od potwierdzenia IN7 do zabrania
 jej przez lancuch. Na tej fladze chodzi tonSt08Drop, dzieki
 czemu odliczanie NIE ZALEZY od tego, w ktorym kroku toru B2
 paleta akurat stoi.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">tOutStep</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tSt08_DropDelay</Name><Type>TIME</Type><Comment><![CDATA[ Zadania startu torow. Tor URUCHAMIA SIE SAM, w swoim kroku 0.
 Powod jest w komentarzu przy silniku krokow nizej - w skrocie:
 krok wpisany z ZEWNATRZ wykonalby sie jeszcze w tym samym
 cyklu, ze stara flaga xOutAdvance, i przeskoczylby natychmiast.
 -----------------------------------------------------
 STACJA 8 - POSADZENIE PALETY NOK NA LANCUCHU
 -----------------------------------------------------

 Na stacji 8 nie ma blokady, a transporter chodzi tak
 gladko, ze paleta zatrzymuje sie raz dalej, raz blizej.
 Dlatego po tSt08_DropDelay od IN7 OPUSZCZAMY rolki: paleta
 siada na lancuchu i to on ja wyhamowuje - zawsze tak samo.

 DOTYCZY WYLACZNIE PALET NOK, bo tylko one jada lancuchem.
 Paleta OK jedzie dalej rolkami i zatrzymuje sie jak dotad -
 dla niej nic sie nie zmienia.

 Dwie NIEZALEZNE czasowki od tego samego IN7:
   tFeedSt08Stop   zdjecie zadania z falownika (dobieg)
   tSt08_DropDelay opuszczenie rolek pod paleta]]></Comment><BitSize>32</BitSize><Default><DateTime>T#830MS</DateTime></Default></SubItem><SubItem><Name Static="true">tonOutStep</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tonSt08Drop</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">xSt08_PalletNOK</Name><Type>BOOL</Type><Comment><![CDATA[ Czy TA paleta jedzie trasa odrzutu (lancuchem).
 W tej probie wszystkie palety jada na stacje 16, wiec bit
 jest TRUE. Gdy dojdzie klasyfikacja OK/NOK, ma go ustawiac
 wynik badania, a nie operator.]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xOutStart</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOut2Start</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOut3Start</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_CanPass</Name><Type>BOOL</Type><Comment><![CDATA[ Droga ze stacji 5 wolna: tor B1 pusty i stacja 7 pusta]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOut2NewStep</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nOut2Step</Name><Type>INT</Type><Comment><![CDATA[ -----------------------------------------------------
 BUFOROWANIE - TOR B ROZBITY NA TRZY ODCINKI
 -----------------------------------------------------

 Odcinki wyznaczaja CZUJNIKI, bo tylko one wiedza, gdzie
 naprawde stoi paleta:

   nOutStep   B1  st.5 -> 6 -> 7    konczy sie na IN5
   nOut2Step  B2  st.7 -> 8         konczy sie na IN7
   nOut3Step  B3  st.8 -> ... -> 16 konczy sie na IN10

 Kazdy odcinek zwalnia sie DOPIERO wtedy, gdy nastepny
 przejmie palete. Dzieki temu w obiegu moga byc naraz:
 paleta na stacji 5, paleta na 7, paleta na 8 i paleta
 w drodze na 16 - zamiast jednej na cala maszyne.

 Transporter stacji 7 (naped 11) obsluguje B1 i B2, a rolki
 stacji 8 (naped 12) B2. Dlatego paleta czeka w krokach
 205 i 218 z ZATRZYMANYMI napedami, zamiast dojezdzac
 wprost na zajety odcinek.]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">sOut2Phase</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">nOut2StepOld</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xOut2Armed</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOut2Advance</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">tOut2Step</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tonOut2Step</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">nOut3Step</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">sOut3Phase</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">nOut3StepOld</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xOut3NewStep</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOut3Armed</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xOut3Advance</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt04_RollRev</Name><Type>BOOL</Type><Comment><![CDATA[ -----------------------------------------------------
 STACJA 4 - ROLKI DOCISKOWE (NAPED 3)
 -----------------------------------------------------

 Kreca sie razem z transporterem stacji 4 (naped 4).
 Bit ponizej wybiera kierunek obrotu - do ustawienia
 online, bez pobierania projektu.]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">tOut3Step</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tSt05_Push</Name><Type>TIME</Type><Comment><![CDATA[ -----------------------------------------------------
 STACJA 5 - CZAS PCHANIA PALETY DO BLOKADY
 -----------------------------------------------------

 Paleta opiera sie o blokade duzo wczesniej, niz konczy sie
 krok 80. Kazda sekunda ponad to jest transporterem
 mielacym pod stojaca paleta - tak przeciazamy naped 5.
 Po tym czasie napedy 4 i 5 STAJA, a krok trwa dalej.

 DOMYSLNIE ROWNE tFeedToSt05 - czyli tak, jak bylo przed
 wprowadzeniem tej nastawy. Moje 4 s bylo za krotkie
 i paleta nie dojezdzala do blokady.

 Skracaj DOPIERO po obejrzeniu, gdzie paleta sie zatrzymuje:
 ma byc na tyle dlugie, zeby doszla do blokady, i na tyle
 krotkie, zeby transporter nie mielil pod nia bez potrzeby.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#9S</DateTime></Default></SubItem><SubItem><Name Static="true">tonOut3Step</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tonSt05Push</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">xFeedPressOn</Name><Type>BOOL</Type><Comment><![CDATA[ Stan dociskow stacji 4 w tej probie - przepisywany co cykl]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xFeedPressLoOn</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xFeed05_Block</Name><Type>BOOL</Type><Comment><![CDATA[ blokada wysunieta]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xFeed05_Lift</Name><Type>BOOL</Type><Comment><![CDATA[ szczeki podniesione]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">tFeedToSt05</Name><Type>TIME</Type><Comment><![CDATA[ Czas przejazdu st.4 -> st.5. Stacja 5 nie ma czujnika,
 wiec dojazd konczy sie czasowka. Dobrane na maszynie.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#9S</DateTime></Default></SubItem><SubItem><Name Static="true">tFeedSt03Stop</Name><Type>TIME</Type><Comment><![CDATA[ DOBIEG NA STACJI 3. Czujnik IN2 widzi krawedz natarcia
 stosu, a szczeki maja trafic pod DRUGA palete od dolu -
 stos musi wiec dojechac jeszcze kawalek po wykryciu.

 ZERO = stop natychmiast po czujniku, czyli tak, jak bylo.
 Odpowiednik tSt04_StopDelay dla stacji 4.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#0S</DateTime></Default></SubItem><SubItem><Name Static="true">tSt05_Settle</Name><Type>TIME</Type><Comment><![CDATA[ Odstep od zatrzymania palety na stacji 5 do ruszenia
 mechaniki. Stacja 5 nie ma czujnika, wiec nie wiemy, kiedy
 paleta oprze sie o blokade - dajemy jej na to czas.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#8S</DateTime></Default></SubItem><SubItem><Name Static="true">xFeed05_Jaws</Name><Type>BOOL</Type><Comment><![CDATA[ szczeki zamkniete]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xFeed05_Pull</Name><Type>BOOL</Type><Comment><![CDATA[ silowniki rozrywajace w gorze]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nFeedBadDrv</Name><Type>INT</Type><Comment><![CDATA[ Diagnostyka napedow zadanych przez biezacy krok]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">sFeedDrvWhy</Name><Type>STRING(31)</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tFeed5to6</Name><Type>TIME</Type><Comment><![CDATA[ st.5 -> st.6]]></Comment><BitSize>32</BitSize><Default><DateTime>T#12S</DateTime></Default></SubItem><SubItem><Name Static="true">tonFeedDrv</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tFeed9Chain</Name><Type>TIME</Type><Comment><![CDATA[ lancuch st.8 -> st.10]]></Comment><BitSize>32</BitSize><Default><DateTime>T#19S</DateTime></Default></SubItem><SubItem><Name Static="true">tFeed10to14</Name><Type>TIME</Type><Comment><![CDATA[ st.10 -> st.14]]></Comment><BitSize>32</BitSize><Default><DateTime>T#8S</DateTime></Default></SubItem><SubItem><Name Static="true">tFeed14to15</Name><Type>TIME</Type><Comment><![CDATA[ st.14 -> st.15]]></Comment><BitSize>32</BitSize><Default><DateTime>T#8S</DateTime></Default></SubItem><SubItem><Name Static="true">tSt16_Clear</Name><Type>TIME</Type><Comment><![CDATA[ Paleta zniknela z czujnika stacji 16. Po tym czasie
 uznajemy stacje za pusta - odbiera ja operator.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#4S</DateTime></Default></SubItem><SubItem><Name Static="true">tFeedSt08Stop</Name><Type>TIME</Type><Comment><![CDATA[ IN7  stacja 8]]></Comment><BitSize>32</BitSize><Default><DateTime>T#740MS</DateTime></Default></SubItem><SubItem><Name Static="true">tFeedSt16Stop</Name><Type>TIME</Type><Comment><![CDATA[ IN10 stacja 16]]></Comment><BitSize>32</BitSize><Default><DateTime>T#0S</DateTime></Default></SubItem><SubItem><Name Static="true">xFeedRoll08Up</Name><Type>BOOL</Type><Comment><![CDATA[ Rolki podnoszone stacji 8 i 10. TRUE = w gorze, czyli
 transport wzdluz. Na czas przejazdu lancuchem OBIE musza
 zejsc, inaczej szarpalyby palete z dwoch stron.]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xFeedRoll10Up</Name><Type>BOOL</Type><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xSafetyOK</Name><Type>BOOL</Type><Comment><![CDATA[ Zezwolenie z lancucha bezpieczenstwa]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xCmdResetDrives</Name><Type>BOOL</Type><Comment><![CDATA[ KASOWANIE BLEDOW WSZYSTKICH FALOWNIKOW - dziala na zbocze.
 Bit sam sie zdejmuje po wystawieniu impulsu.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xAutoResetOnStart</Name><Type>BOOL</Type><Comment><![CDATA[ Automatyczne kasowanie bledow po wcisnieciu START.
 FALSE = start nie probuje niczego kasowac.]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xCylEnable</Name><Type>BOOL</Type><Comment><![CDATA[ FALSE = same transportery, silowniki stoja]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xUseSensors</Name><Type>BOOL</Type><Comment><![CDATA[ =========================================================
 CZUJNIKI
 =========================================================

 FALSE = jedziemy na samych czasowkach, tak jak dotad.
 TRUE  = kroki wypisane w ACT_Move koncza sie czujnikiem,
         a czasowka pracuje juz tylko jako watchdog.]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xPal_St03</Name><Type>BOOL</Type><Comment><![CDATA[ IN2   stacja 3]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">tResetGap</Name><Type>TIME</Type><Comment><![CDATA[ Odstep miedzy kolejnymi probami kasowania]]></Comment><BitSize>32</BitSize><Default><DateTime>T#1S</DateTime></Default></SubItem><SubItem><Name Static="true">tStepTime</Name><Type>TIME</Type><Comment><![CDATA[ Czas jednego kroku - przejazd palety miedzy stacjami]]></Comment><BitSize>32</BitSize><Default><DateTime>T#5S</DateTime></Default></SubItem><SubItem><Name Static="true">lrTestFreq</Name><Type>LREAL</Type><Comment><![CDATA[ Czestotliwosc BAZOWA transporterow [Hz]. Uzywana wszedzie,
 gdzie alrDriveFreq nie ma wpisanej wlasnej wartosci.]]></Comment><BitSize>64</BitSize><Default><Value>20</Value></Default></SubItem><SubItem><Name Static="true">alrDriveFreq</Name><Type>LREAL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ =========================================================
 CZESTOTLIWOSC OSOBNO DLA KAZDEGO NAPEDU [Hz]
 =========================================================

 Zero znaczy "uzyj lrTestFreq". Wpisanie liczby dotyczy
 tylko tego jednego falownika.

 Przydzial stacja -> falownik:
   st.1  -> 8     st.5  -> 5     st.9  -> 7      st.13 -> 15
   st.2  -> 9     st.6  -> 6     st.10 -> 16     st.14 -> 17
   st.3  -> 10    st.7  -> 11    st.11 -> 13     st.15 -> 18
   st.4  -> 4     st.8  -> 12    st.12 -> 14     st.16 -> 19

 Krzywki 1 i 2 maja wlasna lrCamFreq i ta tablica ich nie
 dotyczy.

 UWAGA: naped czyta czestotliwosc przy STARCIE (M_Start jest
 wolane na zboczu). Zmiana w trakcie jazdy zadziala dopiero
 przy nastepnym ruszeniu.]]></Comment><BitSize>1280</BitSize></SubItem><SubItem><Name Static="true">tChainTime</Name><Type>TIME</Type><Comment><![CDATA[ Przejazd poprzeczny transporterem lancuchowym jest dluzszy]]></Comment><BitSize>32</BitSize><Default><DateTime>T#6S</DateTime></Default></SubItem><SubItem><Name Static="true">tCylTime</Name><Type>TIME</Type><Comment><![CDATA[ Czas jednego ruchu silownika. Czujnikow polozenia jeszcze
 nie ma, wiec po tym czasie uznajemy ruch za wykonany.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#2S</DateTime></Default></SubItem><SubItem><Name Static="true">tSt04_UpToLo</Name><Type>TIME</Type><Comment><![CDATA[ Stacja 4 - dociski gorne i dolne maja isc praktycznie razem.
 Gorne schodza pierwsze, dolne po tym krotkim odstepie,
 zeby dolne nie uniosly palety. Cofanie jest jednoczesne.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#2200MS</DateTime></Default></SubItem><SubItem><Name Static="true">nStacksSeen</Name><Type>UDINT</Type><Comment><![CDATA[ STACJA 1 - czujnika IN1 NIE uzywamy. Zastepuje go bit
 xSt01_StackReady zadeklarowany na gorze.]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">xPal_St04In</Name><Type>BOOL</Type><Comment><![CDATA[ IN3   wjazd na stacje 4]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xPal_St04End</Name><Type>BOOL</Type><Comment><![CDATA[ IN4   koniec testu desek]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xPal_St07</Name><Type>BOOL</Type><Comment><![CDATA[ IN5   stacja 7]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xPal_St13</Name><Type>BOOL</Type><Comment><![CDATA[ IN6   koniec stacji 13]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xPal_St08</Name><Type>BOOL</Type><Comment><![CDATA[ IN7   stacja 8]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xPal_St11</Name><Type>BOOL</Type><Comment><![CDATA[ IN8   stacja 11]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xPal_St16</Name><Type>BOOL</Type><Comment><![CDATA[ IN10  stacja 16]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">axInRaw</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>10</Elements></ArrayInfo><Comment><![CDATA[ Surowe wejscia - do podgladu bez otwierania GVL]]></Comment><BitSize>80</BitSize></SubItem><SubItem><Name Static="true">axInInverted</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>10</Elements></ArrayInfo><Comment><![CDATA[ -----------------------------------------------------
 POLARYZACJA CZUJNIKOW - JEDYNE MIEJSCE
 -----------------------------------------------------

 TRUE  = czujnik ROZWIERA przy palecie (0 = paleta)
 FALSE = czujnik ZWIERA przy palecie   (1 = paleta)

 Wartosci ponizej sa wg opisu z maszyny. Jesli ktorys
 czujnik zachowa sie odwrotnie, przestawia sie JEDEN bit
 online - bez zmiany kodu i bez pobierania projektu.

   1  st.1              nieuzywany
   2  st.3              ROZWIERA - stwierdzone na maszynie,
                        wbrew pierwotnemu opisu
   3  wjazd st.4        rozwiera
   4  koniec testu st.4 rozwiera
   5  st.7              zwiera
   6  koniec st.13      rozwiera
   7  st.8              zwiera
   8  st.11             zwiera
   9  niepodlaczony
  10  st.16             zwiera]]></Comment><BitSize>80</BitSize><Default><SubItem><Name>[1]</Name><Bool>false</Bool></SubItem><SubItem><Name>[2]</Name><Bool>true</Bool></SubItem><SubItem><Name>[3]</Name><Bool>true</Bool></SubItem><SubItem><Name>[4]</Name><Bool>true</Bool></SubItem><SubItem><Name>[5]</Name><Bool>false</Bool></SubItem><SubItem><Name>[6]</Name><Bool>true</Bool></SubItem><SubItem><Name>[7]</Name><Bool>false</Bool></SubItem><SubItem><Name>[8]</Name><Bool>false</Bool></SubItem><SubItem><Name>[9]</Name><Bool>false</Bool></SubItem><SubItem><Name>[10]</Name><Bool>false</Bool></SubItem></Default></SubItem><SubItem><Name Static="true">xStepWatchdog</Name><Type>BOOL</Type><Comment><![CDATA[ WATCHDOG KROKU CZUJNIKOWEGO.

 FALSE = krok czeka na czujnik BEZ KONCA. Tak jedziemy przy
         recznym wyzwalaniu czujnikow - nic nie przeskoczy
         kroku, dopoki sam nie podasz sygnalu.
 TRUE  = po tMoveTimeout krok konczy sie mimo wszystko,
         zapala sie xStepTimeout i rosnie nTimeouts.]]></Comment><BitSize>8</BitSize><Default><Bool>false</Bool></Default></SubItem><SubItem><Name Static="true">tMoveTimeout</Name><Type>TIME</Type><BitSize>32</BitSize><Default><DateTime>T#20S</DateTime></Default></SubItem><SubItem><Name Static="true">xStepTimeout</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">START_DESTACK</Name><Type>BOOL</Type><Comment><![CDATA[ desztaplarka, stacja 3]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">START_STACK</Name><Type>BOOL</Type><Comment><![CDATA[ sztaplarka, stacja 11]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">JOG_DESTACK_FWD</Name><Type>BOOL</Type><Comment><![CDATA[ -----------------------------------------------------
 JAZDA RECZNA KRZYWKA
 -----------------------------------------------------

 Trzymasz bit - wozek jedzie. Puszczasz - staje, hamulec
 zaklada sie tCamBrakeHold pozniej, tak samo jak w cyklu.

 Dziala TYLKO przy zdjetym starcie danej maszyny, zeby
 nigdy nie walczyc z sekwencja. Sluzy do sprawdzenia,
 czy enkoder liczy i w ktora strone.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nTimeouts</Name><Type>UDINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tSt04_EntryToPress</Name><Type>TIME</Type><Comment><![CDATA[ =========================================================
 STACJA 4 - TEST NA JADACEJ PALECIE
 =========================================================

 Paleta nie zatrzymuje sie pod rolkami. Czujnik wjazdu (IN3)
 odlicza tSt04_EntryToPress i wtedy rolki schodza na deski.
 Czujnik konca testu (IN4) NATYCHMIAST je cofa, a transporter
 stoi tSt04_StopDelay pozniej - paleta dojezdza do konca stacji.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#2600MS</DateTime></Default></SubItem><SubItem><Name Static="true">tSt04_StopDelay</Name><Type>TIME</Type><BitSize>32</BitSize><Default><DateTime>T#300MS</DateTime></Default></SubItem><SubItem><Name Static="true">JOG_DESTACK_REV</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">JOG_STACK_FWD</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">JOG_STACK_REV</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeJog</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xStJog</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">TEACH_DE_BOTTOM</Name><Type>BOOL</Type><Comment><![CDATA[ -----------------------------------------------------
 UCZENIE POZYCJI
 -----------------------------------------------------

 Dojedz jogiem tam, gdzie wozek ma stawac, i podaj bit.
 Zbocze 0 -> 1 przepisuje BIEZACA pozycje enkodera do
 odpowiedniej nastawy. Koniec z wpisywaniem liczb z palca.

 UWAGA: nastawy siedza na razie w MAIN, wiec pobranie
 projektu je kasuje. Po ustaleniu przenosimy do GVL_PERSIST.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">TEACH_DE_MIDDLE</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">TEACH_DE_TOP</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">TEACH_ST_BOTTOM</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">TEACH_ST_MIDDLE</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">TEACH_ST_TOP</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeSetAccum</Name><Type>BOOL</Type><Comment><![CDATA[ Ustawienie punktu odniesienia osi, impuls jednocyklowy]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">tJawTime</Name><Type>TIME</Type><Comment><![CDATA[ Ruch szczek - czujnikow polozenia nie ma]]></Comment><BitSize>32</BitSize><Default><DateTime>T#2S</DateTime></Default></SubItem><SubItem><Name Static="true">rtrgTeach</Name><Type Namespace="Tc2_Standard">R_TRIG</Type><ArrayInfo><LBound>1</LBound><Elements>6</Elements></ArrayInfo><BitSize>768</BitSize></SubItem><SubItem><Name Static="true">sTeachLast</Name><Type>STRING(79)</Type><Comment><![CDATA[ Ostatnio nauczona pozycja - potwierdzenie na podgladzie]]></Comment><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">lrCamFreq</Name><Type>LREAL</Type><Comment><![CDATA[ Czestotliwosc krzywek. Osobno od transporterow.
 Nizej niz transportery - wolniej znaczy krotszy dojazd
 po zdjeciu zadania, a wiec mniejszy blad pozycji.]]></Comment><BitSize>64</BitSize><Default><Value>15</Value></Default></SubItem><SubItem><Name Static="true">tDeGripDelay</Name><Type>TIME</Type><Comment><![CDATA[ Odstep od ZALOZENIA hamulca do chwytu szczekami.
 Wozek musi sie uspokoic, zanim szczeki wejda pod palete.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#1S</DateTime></Default></SubItem><SubItem><Name Static="true">diCamStopLead</Name><Type>DINT</Type><Comment><![CDATA[ -----------------------------------------------------
 POZYCJE I LICZNIKI SIEDZA W GVL_PERSIST
 -----------------------------------------------------

 Nastawy:  GVL_PERSIST.St03.Cfg.diPosBottom / Middle / Top
           GVL_PERSIST.St11.Cfg.diPosBottom / Middle / Top
           GVL_PERSIST.St03.Cfg.nStackSize
 Liczniki: GVL_PERSIST.St03.Mem.nRemaining / nHeld
           GVL_PERSIST.St11.Mem.nHeld

 Sa NIEULOTNE, wiec przezywaja zanik zasilania, aktywacje
 konfiguracji i reset cold. Uczenie pozycji zapisuje wprost
 tam - nie ma drugiej kopii, ktora moglaby sie rozjechac.
 Wyprzedzenie hamowania - zadanie znika tyle przed celem.
 Zaczynamy od zera i ustawiamy z odczytu diCoast.]]></Comment><BitSize>32</BitSize><Default><Value>0</Value></Default></SubItem><SubItem><Name Static="true">diCamTol</Name><Type>DINT</Type><Comment><![CDATA[ Okno "jestem na miejscu" przy bazowaniu. Bez niego wozek
 stojacy tuz przy dolnej pozycji robilby caly obrot, zeby
 do niej "dojechac".]]></Comment><BitSize>32</BitSize><Default><Value>300</Value></Default></SubItem><SubItem><Name Static="true">diCamOvershoot</Name><Type>DINT</Type><Comment><![CDATA[ Ile impulsow za celem uznajemy jeszcze za "jestem".
 Musi byc WIEKSZE niz dojazd po zdjeciu zadania, inaczej
 wozek stojacy tuz ZA punktem objechalby caly obrot,
 zeby do niego wrocic.]]></Comment><BitSize>32</BitSize><Default><Value>5000</Value></Default></SubItem><SubItem><Name Static="true">diDeGoToEnc</Name><Type>DINT</Type><Comment><![CDATA[ -----------------------------------------------------
 DOKAD JEDZIE BIEZACY KROK
 -----------------------------------------------------

 Krok podaje WARTOSC ENKODERA, do ktorej ma dojechac,
 a droge liczymy raz, przy wejsciu w krok, z zywej
 pozycji. Nigdzie nie zakladamy, ile impulsow ma cykl
 maszyny - to bylo zrodlo kumulujacego sie bledu.]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStGoToEnc</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diDeCycleCounts</Name><Type>DINT</Type><Comment><![CDATA[ -----------------------------------------------------
 POMIAR - ILE IMPULSOW MA NAPRAWDE CYKL MASZYNY
 -----------------------------------------------------

 diDeCycleCounts   droga przejechana miedzy kolejnymi
                   dolnymi pozycjami. Jesli enkoder jest
                   1:1 z korba, ma byc okolo 65536.
                   Kazda inna liczba znaczy, ze cykl
                   maszyny to nie jest jeden obrot enkodera.
 diDeBottomErr     o ile minelismy nauczony dol, ze znakiem
 diDeCoastMax      najwiekszy zaobserwowany dojazd. Musi
                   byc MNIEJSZY niz diCamOvershoot, inaczej
                   ruch do punktu tuz za nami pojedzie
                   dookola.]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diDeBottomErr</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diDeCoastMax</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStCycleCounts</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStBottomErr</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStCoastMax</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">xStSetAccum</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeCfgOK</Name><Type>BOOL</Type><Comment><![CDATA[ -----------------------------------------------------
 KONTROLA POPRAWNOSCI NASTAW POZYCJI
 -----------------------------------------------------

 Trzy pozycje musza byc od siebie ODDALONE. Zerowe albo
 pomylone nastawy oznaczaja, ze wozek "juz jest na miejscu"
 w kazdym kroku - a wtedy szczeki zamykaja sie na dole,
 na stosie. Cykl nie ma prawa ruszyc na takich nastawach.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xStCfgOK</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xEncCheckDone</Name><Type>BOOL</Type><Comment><![CDATA[ -----------------------------------------------------
 KONTROLA ENKODERA PO STARCIE
 -----------------------------------------------------

 Enkoder absolutny powinien utrzymac wartosc przez zanik
 zasilania. Zapamietujemy ja na biezaco w GVL_PERSIST
 i po starcie porownujemy z odczytem. Zgadza sie -
 bazowanie jest zbedne. Nie zgadza sie - kod to zglasza,
 zamiast po cichu jechac wedlug zlych pozycji.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">diDeAccumSet</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStAccumSet</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diTmp</Name><Type>DINT</Type><Comment><![CDATA[ Roboczy]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diCamMinSpan</Name><Type>DINT</Type><BitSize>32</BitSize><Default><Value>1000</Value></Default></SubItem><SubItem><Name Static="true">diDeEncJump</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStEncJump</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">sEncCheck</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">diEncCheckTol</Name><Type>DINT</Type><Comment><![CDATA[ Ile impulsow roznicy jeszcze wybaczamy po starcie]]></Comment><BitSize>32</BitSize><Default><Value>500</Value></Default></SubItem><SubItem><Name Static="true">tCamBrakeRelease</Name><Type>TIME</Type><Comment><![CDATA[ START: wyprzedzenie zdjecia hamulca przed komenda dla
 falownika. ZERO = jednoczesnie, i tak ma byc.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#0S</DateTime></Default></SubItem><SubItem><Name Static="true">tCamBrakeHold</Name><Type>TIME</Type><Comment><![CDATA[ STOP: ile hamulec czeka po zdjeciu komendy z falownika.
 Rampa hamowania falownika to 1 s, wiec hamulec zaciska sie
 na wolno obracajacym sie jeszcze wale - SWIADOMIE, zeby
 nie puszczac wozka wolno.]]></Comment><BitSize>32</BitSize><Default><DateTime>T#700MS</DateTime></Default></SubItem><SubItem><Name Static="true">RESET_CAM</Name><Type>BOOL</Type><Comment><![CDATA[ Kasowanie czuwaka obu osi, dziala na zbocze]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">RESET_CYCLE</Name><Type>BOOL</Type><Comment><![CDATA[ =========================================================
 RESET CYKLU DO ZERA
 =========================================================

 Po recznym oproznieniu maszyny z palet. Sprowadza obie
 maszyny i transport do kroku 0, zeruje liczniki palet
 i uzgodnienia, kasuje czuwaki osi.

 NICZYM NIE RUSZA. Wozki wroca na dol dopiero przy starcie,
 bo krok 0 obu maszyn to "szczeki otwarte, jazda na dol".

 Bit sam sie zdejmuje.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nDeStep</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">nStStep</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xDe_PalletReleased</Name><Type>BOOL</Type><Comment><![CDATA[ -----------------------------------------------------
 LICZNIKI PALET
 -----------------------------------------------------

 GVL_PERSIST.St03.Mem.nRemaining  ile palet zostalo w desztaplarce razem:
               na transporterze plus wiszace na szczekach
 GVL_PERSIST.St03.Mem.nHeld       ile wisi na szczekach desztaplarki
 GVL_PERSIST.St11.Mem.nHeld       ile palet liczy stos w sztaplarce
 -----------------------------------------------------
 UZGODNIENIA Z TRANSPORTEM
 -----------------------------------------------------
 Desztaplarka zwolnila palete - transport moze ja zabrac]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDe_Empty</Name><Type>BOOL</Type><Comment><![CDATA[ Desztaplarka pusta, cykl zamkniety na pozycji dolnej]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">rtrgResetCycle</Name><Type Namespace="Tc2_Standard">R_TRIG</Type><BitSize>128</BitSize></SubItem><SubItem><Name Static="true">fbCamDestack</Name><Type>FB_CamAxis</Type><Comment><![CDATA[ -----------------------------------------------------
 PODGLAD OSI
 -----------------------------------------------------]]></Comment><BitSize>3072</BitSize></SubItem><SubItem><Name Static="true">fbCamStack</Name><Type>FB_CamAxis</Type><BitSize>3072</BitSize></SubItem><SubItem><Name Static="true">sDePhase</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">sStPhase</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">nDeCycles</Name><Type>UDINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">nStCycles</Name><Type>UDINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">xSt_StackReady</Name><Type>BOOL</Type><Comment><![CDATA[ Sztaplarka ma pelny stos na transporterze]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeArmed</Name><Type>BOOL</Type><Comment><![CDATA[ Czujnik musi byc najpierw WOLNY, zeby sie zaliczyl]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xStArmed</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeJawsClosed</Name><Type>BOOL</Type><Comment><![CDATA[ Stan szczek deklarowany przez KAZDY krok i przepisywany
 na cewki co cykl. Poleganie na tym, ze cewka zachowa
 wartosc miedzy krokami, juz raz nas kosztowalo prawdziwy
 blad - ACT_ClearCoils zeruje je w kazdym cyklu.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">tDeBrakeWait</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tonDeBrake</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ -----------------------------------------------------
 CZASOWKI OD ZALOZENIA HAMULCA
 -----------------------------------------------------

 Licza dopiero od chwili, w ktorej hamulec sie ZACISNIE -
 nie od wejscia w krok.]]></Comment><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tonStBrake</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tStBrakeWait</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">xStJawsClosed</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeAdvance</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xStAdvance</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeGo</Name><Type>BOOL</Type><Comment><![CDATA[ Zadanie dla osi - liczone przez maszyne stanow,
 podawane do bloku JEDNYM wywolaniem na cykl]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nDeEncMoves</Name><Type>UDINT</Type><Comment><![CDATA[ -----------------------------------------------------
 ZYCIE ENKODEROW
 -----------------------------------------------------

 Rosna przy KAZDEJ zmianie pozycji. Jesli silnik chodzi,
 a licznik stoi - enkoder nie jest podlinkowany albo nie
 liczy. To rozstrzyga sprawe w jednej liczbie.]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">nStEncMoves</Name><Type>UDINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diDePosOld</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStPosOld</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tonDeStep</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tonStStep</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">tDeStep</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tStStep</Name><Type>TIME</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">xStGo</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeNewStep</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nDeStepOld</Name><Type>INT</Type><Comment><![CDATA[ Wykrycie zmiany kroku. Bez tego krok zaliczylby xInPos
 z POPRZEDNIEJ pozycji i przeskoczyl dwa kroki naraz.]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">diDeTarget</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">diStTarget</Name><Type>DINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">nStStepOld</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xStNewStep</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xDeAtPos</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xStAtPos</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xBrakeDestack</Name><Type>BOOL</Type><Comment><![CDATA[ Cewki hamulcow. TRUE = hamulec ROZLACZONY.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xBrakeStack</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xManExtend</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">nManCyl</Name><Type>INT</Type><Comment><![CDATA[ =========================================================
 RECZNE STEROWANIE POJEDYNCZYM SILOWNIKIEM
 =========================================================

 Do sprawdzenia okablowania bez sekwencji. Gdy nManCyl <> 0,
 sekwencja stoi, transportery stoja, a wybrany silownik
 slucha bitow ponizej.

    1  st.3  szczeki desztaplarki
    2  st.4  dociski gorne
    3  st.4  dociski dolne
    4  st.5  blokada
    5  st.5  podnoszenie szczek
    6  st.5  szczeki (zamkniecie / otwarcie)
    7..12 st.5 silowniki rozrywajace 1..6
   13  st.8  rolki podnoszone
   14  st.10 rolki podnoszone
   15  st.11 szczeki sztaplarki]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xManRetract</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xMoving</Name><Type>BOOL</Type><Comment><![CDATA[ TRUE = przejazd, FALSE = praca stacji]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">rtrgDeStart</Name><Type Namespace="Tc2_Standard">R_TRIG</Type><BitSize>128</BitSize></SubItem><SubItem><Name Static="true">rtrgStStart</Name><Type Namespace="Tc2_Standard">R_TRIG</Type><BitSize>128</BitSize></SubItem><SubItem><Name Static="true">axDriveEnabled</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ =========================================================
 DOPUSZCZENIE NAPEDOW
 =========================================================

 FALSE = naped nie ruszy, chocby krok tego zadal.
 Ustawiane w ACT_Config, mozna zmieniac online.]]></Comment><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">axReverse</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ =========================================================
 KIERUNEK OBROTOW
 =========================================================

 TRUE = jazda w druga strone. Silniki stacji 1, 5, 6, 7,
 8, 9, 14, 15, 16 sa podlaczone odwrotnie - do poprawy
 w szafie, na razie odwracamy bit.]]></Comment><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">nIdx</Name><Type>INT</Type><Comment><![CDATA[ pozycja na trasie]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">nSub</Name><Type>INT</Type><Comment><![CDATA[ krok sekwencji stacji]]></Comment><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">sPhase</Name><Type>STRING(79)</Type><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">axRunReq</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ Ktore napedy maja teraz pracowac]]></Comment><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">aeDrvState</Name><Type>E_NordSK550P_State</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ Stan napedow]]></Comment><BitSize>320</BitSize></SubItem><SubItem><Name Static="true">axDrvRunning</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">xAnyDriveError</Name><Type>BOOL</Type><Comment><![CDATA[ Ktorykolwiek naped zglasza blad]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xAnyDriveFault</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xResetFailed</Name><Type>BOOL</Type><Comment><![CDATA[ Kasowanie nie poskutkowalo - blad wraca albo trzyma]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xResetInProgress</Name><Type>BOOL</Type><Comment><![CDATA[ Trwa kasowanie bledow przed startem]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">alrDrvFreqAct</Name><Type>LREAL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>1280</BitSize></SubItem><SubItem><Name Static="true">axDrvFault</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ UWAGA - to sa DWIE ROZNE rzeczy:
   axDrvFault  blad zglaszany przez falownik (bit 3 StatusWord)
   axDrvError  jakakolwiek blokada: blad, brak zezwolenia
               albo zerwana komunikacja]]></Comment><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">axDrvError</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">awDrvStatus</Name><Type>UINT</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ Slowa sterujace i statusowe - do czytania, co naped
 naprawde zglasza]]></Comment><BitSize>320</BitSize></SubItem><SubItem><Name Static="true">awDrvControl</Name><Type>UINT</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>320</BitSize></SubItem><SubItem><Name Static="true">nResetTries</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xChainInterlock</Name><Type>BOOL</Type><Comment><![CDATA[ Blokada zadzialala - lancuch wymusil postoj rolek 8 i 10]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_BlockLock</Name><Type>BOOL</Type><Comment><![CDATA[ Blokada stacji 5 kontra transporter - patrz ACT_ApplyDrives]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">tThisStep</Name><Type>TIME</Type><Comment><![CDATA[ Czas biezacego kroku]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">tonSt05BlockDown</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">nLoops</Name><Type>UDINT</Type><Comment><![CDATA[ Licznik pelnych przebiegow trasy]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">nCycles</Name><Type>UDINT</Type><Comment><![CDATA[ =========================================================
 LICZNIKI ZYCIA - do sprawdzenia, co sie naprawde wykonuje
 =========================================================

 nCycles     rosnie w kazdym cyklu zadania. Jesli stoi,
             MAIN sie nie wykonuje albo wysypal sie wczesniej.
 nOutWrites  rosnie za kazdym przepisaniem cewek na wyjscia.
             Jesli nCycles rosnie, a nOutWrites stoi -
             program nie dochodzi do ACT_Outputs.
 nCoilsOn    ile cewek jest w tej chwili podanych. Jesli
             rosnie i spada, a nic sie nie rusza - sygnal
             nie dochodzi do zaworu.]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">nOutWrites</Name><Type>UDINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">nCoilsOn</Name><Type>INT</Type><BitSize>16</BitSize></SubItem><SubItem><Name Static="true">xSt03_JawClose</Name><Type>BOOL</Type><Comment><![CDATA[ =========================================================
 CEWKI ZAWOROW
 =========================================================

 Stan trzymany miedzy cyklami. ACT_Outputs przepisuje go
 na wyjscia - mapowanie jest TAM i tylko tam.
 Stacja 3 - szczeki desztaplarki]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt03_JawOpen</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt04_UpExt</Name><Type>BOOL</Type><Comment><![CDATA[ Stacja 4 - dociski. Obie grupy gornych chodza razem.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt04_UpRet</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt04_LoExt</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt04_LoRet</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_BlockExt</Name><Type>BOOL</Type><Comment><![CDATA[ blokada wysuw]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_BlockRet</Name><Type>BOOL</Type><Comment><![CDATA[ blokada opuszczenie]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_LiftUp</Name><Type>BOOL</Type><Comment><![CDATA[ szczeki w gore]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_LiftDown</Name><Type>BOOL</Type><Comment><![CDATA[ szczeki w dol]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt05_JawClose</Name><Type>BOOL</Type><Comment><![CDATA[ trzy pary szczek razem]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">axSt05_PullUp</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>6</Elements></ArrayInfo><BitSize>48</BitSize></SubItem><SubItem><Name Static="true">axSt05_PullDown</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>6</Elements></ArrayInfo><BitSize>48</BitSize></SubItem><SubItem><Name Static="true">xSt08_Up</Name><Type>BOOL</Type><Comment><![CDATA[ Rolki podnoszone]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt08_Down</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt10_Up</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt10_Down</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt11_JawClose</Name><Type>BOOL</Type><Comment><![CDATA[ Stacja 11 - szczeki sztaplarki]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xSt11_JawOpen</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xLogEnable</Name><Type>BOOL</Type><Comment><![CDATA[ FALSE = nie zbieramy wierszy (plik zostaje, nic sie nie psuje)]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xLogNewFile</Name><Type>BOOL</Type><Comment><![CDATA[ Zbocze = nowy plik bez resetu cyklu. Sam sie zdejmuje.]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xLogEvent</Name><Type>BOOL</Type><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xLogInit</Name><Type>BOOL</Type><Comment><![CDATA[ Pamiec do wykrywania zdarzen]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">xInit</Name><Type>BOOL</Type><Comment><![CDATA[ =========================================================
 WEWNETRZNE
 =========================================================]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">fbNord</Name><Type>FB_NordSK550PP</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><Comment><![CDATA[ =========================================================
 NAPEDY
 =========================================================]]></Comment><BitSize>30720</BitSize></SubItem><SubItem><Name Static="true">fbLog</Name><Type>FB_CsvLogger</Type><Comment><![CDATA[ =========================================================
 OBSERWATOR STANU - LOG CSV NA DYSKU STEROWNIKA
 =========================================================

 Co tLogPeriod jeden wiersz z kluczowymi zmiennymi, a do
 tego wiersz na kazde ZDARZENIE: zmiana numeru kroku,
 czujnika, zadania napedu, bledu falownika, bitu operatora,
 szczek, skok enkodera. Najwyzej jeden wiersz na cykl.

 Nowy plik: start PLC, RESET_CYCLE, zbocze xLogNewFile.
 Katalog MUSI istniec na sterowniku: fbLog.sDir
 (domyslnie C:\TesterPalet\log\). Nazwa pliku w fbLog.sFileName.

 Logger tylko CZYTA zmienne procesu - ACT_Logger idzie jako
 ostatnia akcja cyklu, po ACT_Outputs, zeby w pliku bylo to,
 co naprawde poszlo na wyjscia.]]></Comment><BitSize>1133952</BitSize></SubItem><SubItem><Name Static="true">tLogPeriod</Name><Type>TIME</Type><Comment><![CDATA[ Takt wiersza okresowego]]></Comment><BitSize>32</BitSize><Default><DateTime>T#1S</DateTime></Default></SubItem><SubItem><Name Static="true">diLogEncJump</Name><Type>DINT</Type><Comment><![CDATA[ Skok enkodera w jednym cyklu, od ktorego piszemy zdarzenie]]></Comment><BitSize>32</BitSize><Default><Value>2000</Value></Default></SubItem><SubItem><Name Static="true">tonLog</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">sLogWhy</Name><Type>STRING(79)</Type><Comment><![CDATA[ Powod biezacego wiersza - do kolumny "why"]]></Comment><BitSize>640</BitSize></SubItem><SubItem><Name Static="true">nLogRows</Name><Type>UDINT</Type><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">anLogStepOld</Name><Type>INT</Type><ArrayInfo><LBound>1</LBound><Elements>6</Elements></ArrayInfo><BitSize>96</BitSize></SubItem><SubItem><Name Static="true">axLogInOld</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>10</Elements></ArrayInfo><BitSize>80</BitSize></SubItem><SubItem><Name Static="true">axLogReqOld</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">axLogFaultOld</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>20</Elements></ArrayInfo><BitSize>160</BitSize></SubItem><SubItem><Name Static="true">axLogBitOld</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>24</Elements></ArrayInfo><BitSize>192</BitSize></SubItem><SubItem><Name Static="true">axLogBit</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>24</Elements></ArrayInfo><BitSize>192</BitSize></SubItem><SubItem><Name Static="true">sLogPfx</Name><Type>STRING(15)</Type><Comment><![CDATA[ Robocze do skladania nazw kolumn napedow]]></Comment><BitSize>128</BitSize></SubIte