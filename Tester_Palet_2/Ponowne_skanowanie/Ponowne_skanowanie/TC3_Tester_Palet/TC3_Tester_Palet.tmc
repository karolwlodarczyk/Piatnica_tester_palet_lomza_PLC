 =========================================================]]></Comment><BitSize>256</BitSize><BaseType>ST_St04Cfg</BaseType><Properties><Property><Name>TcPersistent</Name></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>4344128</BitOffs></Symbol><Symbol><Name>GVL_PERSIST.St05</Name><BitSize>96</BitSize><BaseType>ST_St05Cfg</BaseType><Properties><Property><Name>TcPersistent</Name></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>4344384</BitOffs></Symbol><Symbol><Name>GVL_PERSIST.St03</Name><Comment><![CDATA[ =========================================================
